
@baseUrl = http://localhost:3000

# IDs dos dados de teste existentes no banco.
# Ajuste somente se as equipes ou os usuários forem diferentes.
@equipePrincipalId = 2
@equipeMembroId = 3
@equipeExternaId = 4

@usuarioArthurId = 1
@usuarioJoaoId = 2

# ============================================================
# AUTENTICACAO
# Credenciais definidas em .vscode/settings.json
# ============================================================

### [AUTH-01] Login do Arthur (DONO)
# Esperado: 200 OK
# @name loginArthur
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailDono}}",
    "senha": "{{senhaDono}}"
}

### [AUTH-02] Login do João
# Esperado: 200 OK
# @name loginJoao
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailLider}}",
    "senha": "{{senhaLider}}"
}

### [AUTH-03] Login da Maria (VISUALIZADOR)
# Esperado: 200 OK
# @name loginVisualizador
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailMaria}}",
    "senha": "{{senhaMaria}}"
}


# ============================================================
# CRIACAO DE TAREFAS
# ============================================================

### [CRIACAO-01] Criar tarefa individual
# Esperado: 201 Created
# @name criarTarefaIndividual
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Estudar React",
    "descricao": "Revisar componentes e hooks",
    "prioridade": "MEDIA"
}

### [CRIACAO-02] Criar tarefa de equipe como DONO
# Esperado: 201 Created
# @name criarTarefaEquipe
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Implementar dashboard da equipe",
    "descricao": "Desenvolver a interface principal do sistema",
    "prioridade": "ALTA",
    "equipeId": {{equipePrincipalId}},
    "responsavelId": {{usuarioJoaoId}}
}

### [CRIACAO-03] Impedir responsável fora da equipe
# Esperado: 400 Bad Request
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Teste de responsável inválido",
    "prioridade": "MEDIA",
    "equipeId": {{equipePrincipalId}},
    "responsavelId": 99999
}

### [CRIACAO-04] MEMBRO não pode atribuir tarefa a outra pessoa
# Esperado: 403 Forbidden
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginJoao.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Teste de permissão do membro",
    "prioridade": "MEDIA",
    "equipeId": {{equipeMembroId}},
    "responsavelId": {{usuarioArthurId}}
}

### [CRIACAO-05] MEMBRO criando tarefa para si mesmo
# Esperado: 201 Created
# @name criarTarefaComoMembro
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginJoao.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Desenvolver tela de configurações",
    "descricao": "Implementar as configurações do usuário",
    "prioridade": "MEDIA",
    "equipeId": {{equipeMembroId}},
    "responsavelId": {{usuarioJoaoId}}
}

### [CRIACAO-06] Preparar tarefa para testar permissões de MEMBRO
# Esperado: 201 Created
# @name criarTarefaPermissaoMembro
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Revisar arquitetura da equipe",
    "descricao": "Tarefa exclusiva do Arthur para validar permissões",
    "prioridade": "MEDIA",
    "equipeId": {{equipeMembroId}},
    "responsavelId": {{usuarioArthurId}}
}


# ============================================================
# TAREFAS INDIVIDUAIS
# ============================================================

### [INDIVIDUAL-01] Listar tarefas individuais
# Esperado: 200 OK
GET {{baseUrl}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [INDIVIDUAL-02] Buscar tarefa individual
# Esperado: 200 OK
GET {{baseUrl}}/tarefas/{{criarTarefaIndividual.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [INDIVIDUAL-03] Atualizar tarefa individual
# Esperado: 200 OK
PUT {{baseUrl}}/tarefas/{{criarTarefaIndividual.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Estudar React e TypeScript",
    "status": "EM_ANDAMENTO",
    "prioridade": "ALTA"
}

### [INDIVIDUAL-04] Impedir acesso de outro usuário
# Esperado: 404 Not Found
GET {{baseUrl}}/tarefas/{{criarTarefaIndividual.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}


# ============================================================
# ISOLAMENTO ENTRE TAREFAS
# ============================================================

### [ISOLAMENTO-01] Impedir acesso à tarefa de equipe pela rota individual
# Esperado: 404 Not Found
GET {{baseUrl}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [ISOLAMENTO-02] Impedir acesso à tarefa individual pela rota de equipe
# Esperado: 404 Not Found
GET {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaIndividual.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}


# ============================================================
# CONSULTAS DE TAREFAS DE EQUIPE
# ============================================================

### [EQUIPE-01] Listar tarefas da equipe principal como DONO
# Esperado: 200 OK
GET {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [EQUIPE-02] Listar tarefas da equipe principal como LIDER
# Esperado: 200 OK
# João precisa ser LIDER na equipe principal.
GET {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas
Authorization: Bearer {{loginJoao.response.body.$.token}}

### [EQUIPE-03] Consultar tarefas de equipe inexistente
# Confirmar se o serviço retorna 403 ou 404.
GET {{baseUrl}}/equipes/99999/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [EQUIPE-04] Bloquear acesso à equipe externa
# Esperado: 403 Forbidden
# João não pode pertencer à equipe externa.
GET {{baseUrl}}/equipes/{{equipeExternaId}}/tarefas
Authorization: Bearer {{loginJoao.response.body.$.token}}

### [EQUIPE-05] Buscar tarefa como DONO
# Esperado: 200 OK
GET {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [EQUIPE-06] Buscar tarefa como LIDER
# Esperado: 200 OK
GET {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}

### [EQUIPE-07] Impedir consulta de tarefa em outra equipe
# Esperado: 404 Not Found
GET {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [EQUIPE-08] VISUALIZADOR consulta tarefa
# Esperado: 200 OK
GET {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginVisualizador.response.body.$.token}}


# ============================================================
# ATUALIZACAO DE TAREFAS DE EQUIPE
# ============================================================

### [ATUALIZACAO-01] DONO atualiza tarefa
# Esperado: 200 OK
PUT {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Implementar dashboard principal da equipe",
    "descricao": "Desenvolver a interface e os indicadores",
    "status": "EM_ANDAMENTO",
    "prioridade": "ALTA"
}

### [ATUALIZACAO-02] LIDER atualiza tarefa
# Esperado: 200 OK
PUT {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}
Content-Type: application/json

{
    "status": "CONCLUIDA"
}

### [ATUALIZACAO-03] MEMBRO atualiza tarefa atribuída a ele
# Esperado: 200 OK
PUT {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaComoMembro.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}
Content-Type: application/json

{
    "status": "EM_ANDAMENTO"
}

### [ATUALIZACAO-04] MEMBRO tenta atualizar tarefa de outra equipe
# Esperado: 404 Not Found
PUT {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}
Content-Type: application/json

{
    "status": "PENDENTE"
}

### [ATUALIZACAO-05] MEMBRO tenta atualizar tarefa de outra pessoa
# Esperado: 403 Forbidden
PUT {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaPermissaoMembro.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}
Content-Type: application/json

{
    "status": "CONCLUIDA"
}

### [ATUALIZACAO-06] Usuário externo tenta atualizar tarefa
# Esperado: 403 Forbidden
PUT {{baseUrl}}/equipes/{{equipeExternaId}}/tarefas/{{criarTarefaPermissaoMembro.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}
Content-Type: application/json

{
    "status": "CONCLUIDA"
}

### [ATUALIZACAO-07] VISUALIZADOR tenta atualizar tarefa
# Esperado: 403 Forbidden
PUT {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginVisualizador.response.body.$.token}}
Content-Type: application/json

{
    "status": "PENDENTE"
}


# ============================================================
# VALIDACOES DE DADOS
# ============================================================

### [VALIDACAO-01] Título numérico
# Esperado: 400 Bad Request
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": 123
}

### [VALIDACAO-02] Descrição com tipo inválido
# Esperado: 400 Bad Request
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Teste de validação",
    "descricao": 123
}

### [VALIDACAO-03] Título vazio
# Esperado: 400 Bad Request
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginArthur.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "   "
}


# ============================================================
# TESTES DE PERMISSAO DE EXCLUSAO
# Executar antes das exclusoes bem-sucedidas.
# ============================================================

### [PERMISSAO-01] VISUALIZADOR tenta excluir tarefa
# Esperado: 403 Forbidden
DELETE {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginVisualizador.response.body.$.token}}

### [PERMISSAO-02] MEMBRO tenta excluir tarefa de outro criador
# Esperado: 403 Forbidden
DELETE {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaPermissaoMembro.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}

### [PERMISSAO-03] Usuário externo tenta excluir tarefa
# Esperado: 403 Forbidden
DELETE {{baseUrl}}/equipes/{{equipeExternaId}}/tarefas/{{criarTarefaPermissaoMembro.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}


# ============================================================
# EXCLUSAO E VERIFICACAO
# Executar esta secao por ultimo.
# ============================================================

### [EXCLUSAO-01] MEMBRO exclui tarefa que criou
# Esperado: 204 No Content
DELETE {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaComoMembro.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}

### [EXCLUSAO-02] Consultar tarefa excluída pelo MEMBRO
# Esperado: 404 Not Found
GET {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaComoMembro.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [EXCLUSAO-03] LIDER exclui tarefa criada pelo DONO
# Esperado: 204 No Content
DELETE {{baseUrl}}/equipes/{{equipePrincipalId}}/tarefas/{{criarTarefaEquipe.response.body.$.id}}
Authorization: Bearer {{loginJoao.response.body.$.token}}

### [EXCLUSAO-04] DONO exclui tarefa da equipe
# Esperado: 204 No Content
DELETE {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaPermissaoMembro.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [EXCLUSAO-05] Impedir exclusão repetida
# Esperado: 404 Not Found
DELETE {{baseUrl}}/equipes/{{equipeMembroId}}/tarefas/{{criarTarefaPermissaoMembro.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [EXCLUSAO-06] Excluir tarefa individual
# Esperado: 204 No Content
DELETE {{baseUrl}}/tarefas/{{criarTarefaIndividual.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}

### [EXCLUSAO-07] Consultar tarefa individual excluída
# Esperado: 404 Not Found
GET {{baseUrl}}/tarefas/{{criarTarefaIndividual.response.body.$.id}}
Authorization: Bearer {{loginArthur.response.body.$.token}}
