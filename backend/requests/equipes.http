
@baseUrl = http://localhost:3000

# Dados existentes no banco de testes
@equipePrincipalId = 2
@equipeExternaId = 4
@usuarioArthurId = 1
@usuarioJoaoId = 2

# PRE-CONDICOES:
# Arthur deve ser DONO da equipe principal.
# Joao deve ser LIDER da equipe principal.
# Joao nao deve participar da equipe externa.
# As credenciais estao em .vscode/settings.json.

# ============================================================
# AUTENTICACAO
# ============================================================

### [AUTH-01] Login como DONO (Arthur)
# Esperado: 200 OK
# @name loginDono
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailDono}}",
    "senha": "{{senhaDono}}"
}

### [AUTH-02] Login como LIDER (João)
# Esperado: 200 OK
# @name loginLider
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailLider}}",
    "senha": "{{senhaLider}}"
}


# ============================================================
# CRIACAO DE EQUIPES
# ============================================================

### [CRIACAO-01] DONO cria equipe temporária
# Esperado: 201 Created
# @name criarEquipeTeste
POST {{baseUrl}}/equipes
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "nome": "Equipe temporária para exclusão"
}

### [CRIACAO-02] Criar tarefa na equipe temporária
# Esperado: 201 Created
# @name criarTarefaTeste
POST {{baseUrl}}/tarefas
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "titulo": "Tarefa temporária para testar exclusão em cascata",
    "descricao": "Esta tarefa deve ser removida com a equipe.",
    "prioridade": "MEDIA",
    "equipeId": {{criarEquipeTeste.response.body.$.id}}
}


# ============================================================
# LISTAGEM E CONSULTA
# ============================================================

### [LISTAGEM-01] Listar equipes do Arthur
# Esperado: 200 OK
GET {{baseUrl}}/equipes
Authorization: Bearer {{loginDono.response.body.$.token}}

### [LISTAGEM-02] Listar equipes do João
# Esperado: 200 OK
GET {{baseUrl}}/equipes
Authorization: Bearer {{loginLider.response.body.$.token}}

### [CONSULTA-01] Consultar equipe principal
# Esperado: 200 OK
GET {{baseUrl}}/equipes/{{equipePrincipalId}}
Authorization: Bearer {{loginDono.response.body.$.token}}

### [CONSULTA-02] Consultar equipe temporária
# Esperado: 200 OK
GET {{baseUrl}}/equipes/{{criarEquipeTeste.response.body.$.id}}
Authorization: Bearer {{loginDono.response.body.$.token}}

### [CONSULTA-03] João tenta consultar equipe externa
# Esperado: 403 Forbidden
GET {{baseUrl}}/equipes/{{equipeExternaId}}
Authorization: Bearer {{loginLider.response.body.$.token}}


# ============================================================
# ATUALIZACAO DE EQUIPES
# Executar antes da transferencia de propriedade.
# ============================================================

### [ATUALIZACAO-01] DONO atualiza equipe principal
# Esperado: 200 OK
PUT {{baseUrl}}/equipes/{{equipePrincipalId}}
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "nome": "Equipe para testes - Atualizada"
}

### [ATUALIZACAO-02] LIDER tenta atualizar equipe
# Esperado: 403 Forbidden
PUT {{baseUrl}}/equipes/{{equipePrincipalId}}
Authorization: Bearer {{loginLider.response.body.$.token}}
Content-Type: application/json

{
    "nome": "Alteração indevida pelo LIDER"
}


# ============================================================
# VALIDACAO DE DADOS
# Executar antes da transferencia de propriedade.
# ============================================================

### [VALIDACAO-01] Criar equipe com nome numérico
# Esperado: 400 Bad Request
POST {{baseUrl}}/equipes
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "nome": 123
}

### [VALIDACAO-02] Criar equipe com nome vazio
# Esperado: 400 Bad Request
POST {{baseUrl}}/equipes
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "nome": "   "
}

### [VALIDACAO-03] Atualizar equipe com nome inválido
# Esperado: 400 Bad Request
PUT {{baseUrl}}/equipes/{{equipePrincipalId}}
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "nome": []
}


# ============================================================
# TRANSFERENCIA DE PROPRIEDADE
# Executar os testes desta secao em ordem.
# ============================================================

### [PROPRIEDADE-01] Arthur transfere propriedade para João
# Esperado: 200 OK
# Arthur: DONO -> LIDER
# João: LIDER -> DONO
PATCH {{baseUrl}}/equipes/{{equipePrincipalId}}/propriedade
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "novoDonoId": {{usuarioJoaoId}}
}

### [PROPRIEDADE-02] Novo DONO (João) atualiza equipe
# Esperado: 200 OK
PUT {{baseUrl}}/equipes/{{equipePrincipalId}}
Authorization: Bearer {{loginLider.response.body.$.token}}
Content-Type: application/json

{
    "nome": "Equipe para testes - Novo DONO"
}

### [PROPRIEDADE-03] Antigo DONO (Arthur) tenta atualizar equipe
# Esperado: 403 Forbidden
PUT {{baseUrl}}/equipes/{{equipePrincipalId}}
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "nome": "Alteração indevida pelo antigo DONO"
}

### [PROPRIEDADE-04] João devolve propriedade para Arthur
# Esperado: 200 OK
PATCH {{baseUrl}}/equipes/{{equipePrincipalId}}/propriedade
Authorization: Bearer {{loginLider.response.body.$.token}}
Content-Type: application/json

{
    "novoDonoId": {{usuarioArthurId}}
}


# ============================================================
# EXCLUSAO DE EQUIPES
# Executar esta secao por ultimo.
# ============================================================

### [EXCLUSAO-01] DONO tenta excluir equipe com outros membros
# Esperado: 409 Conflict
DELETE {{baseUrl}}/equipes/{{equipePrincipalId}}
Authorization: Bearer {{loginDono.response.body.$.token}}

### [EXCLUSAO-02] DONO exclui equipe temporária
# Esperado: 204 No Content
# Deve excluir as tarefas e logs vinculados em cascata.
DELETE {{baseUrl}}/equipes/{{criarEquipeTeste.response.body.$.id}}
Authorization: Bearer {{loginDono.response.body.$.token}}

### [EXCLUSAO-03] Consultar equipe após exclusão
# Esperado: 404 Not Found
GET {{baseUrl}}/equipes/{{criarEquipeTeste.response.body.$.id}}
Authorization: Bearer {{loginDono.response.body.$.token}}

### [EXCLUSAO-04] Consultar tarefa da equipe excluída
# Esperado: 404 Not Found
GET {{baseUrl}}/equipes/{{criarEquipeTeste.response.body.$.id}}/tarefas/{{criarTarefaTeste.response.body.$.id}}
Authorization: Bearer {{loginDono.response.body.$.token}}
