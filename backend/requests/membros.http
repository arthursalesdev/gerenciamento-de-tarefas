
@baseUrl = http://localhost:3000

# IDs existentes no banco de testes
@equipeId = 2
@donoId = 1
@liderId = 2
@usuarioMariaId = 3

# PRE-CONDICOES:
# Arthur (ID 1) e DONO da equipe 2.
# Joao (ID 2) e LIDER da equipe 2.
# Maria (ID 3) e uma usuaria cadastrada.
# Para os testes de cargos, ela deve aceitar o convite para entrar na equipe.
# As credenciais estao em .vscode/settings.json.
#
# ATENCAO:
# Os testes de cargos e membros alteram o estado da equipe.
# Execute na ordem indicada.

# ============================================================
# AUTENTICACAO
# ============================================================

### [AUTH-01] Login como DONO
# Esperado: 200 OK
# @name loginDono
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailDono}}",
    "senha": "{{senhaDono}}"
}

### [AUTH-02] Login como LIDER
# Esperado: 200 OK
# @name loginLider
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailLider}}",
    "senha": "{{senhaLider}}"
}

### [AUTH-03] Login como Maria
# Esperado: 200 OK
# @name loginVisualizador
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailMaria}}",
    "senha": "{{senhaMaria}}"
}


# ============================================================
# CONSULTA
# ============================================================

### [MEM-01] Listar membros da equipe
# Esperado: 200 OK
GET {{baseUrl}}/equipes/{{equipeId}}/membros
Authorization: Bearer {{loginDono.response.body.$.token}}


# ============================================================
# ENTRADA NA EQUIPE POR CONVITE
# ============================================================

### [CONVITE-01] DONO envia convite para Maria
# Esperado: 201 Created
# Maria deve estar fora da equipe e não ter convite pendente.
# @name conviteMaria
POST {{baseUrl}}/convites-equipes
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "equipeId": {{equipeId}},
    "convidadoId": {{usuarioMariaId}},
    "cargo": "MEMBRO"
}

### [CONVITE-02] Impedir convite pendente duplicado
# Esperado: 409 Conflict
# Execute depois de CONVITE-01 e antes de Maria aceitar.
POST {{baseUrl}}/convites-equipes
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "equipeId": {{equipeId}},
    "convidadoId": {{usuarioMariaId}},
    "cargo": "MEMBRO"
}

### [CONVITE-03] Maria aceita o convite
# Esperado: 200 OK
# Execute depois de CONVITE-01.
PATCH {{baseUrl}}/convites-equipes/{{conviteMaria.response.body.$.id}}/aceitar
Authorization: Bearer {{loginVisualizador.response.body.$.token}}

# ============================================================
# ALTERACAO DE CARGOS
# ============================================================

### [CARGO-01] DONO promove Maria para LIDER
# Esperado: 200 OK
# Maria precisa ser MEMBRO antes desta requisição.
PATCH {{baseUrl}}/equipes/{{equipeId}}/membros/{{usuarioMariaId}}/cargo
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "cargo": "LIDER"
}

### [CARGO-02] DONO altera Maria para MEMBRO
# Esperado: 200 OK
PATCH {{baseUrl}}/equipes/{{equipeId}}/membros/{{usuarioMariaId}}/cargo
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "cargo": "MEMBRO"
}

### [PERM-01] LIDER tenta alterar cargo do DONO
# Esperado: 403 Forbidden
PATCH {{baseUrl}}/equipes/{{equipeId}}/membros/{{donoId}}/cargo
Authorization: Bearer {{loginLider.response.body.$.token}}
Content-Type: application/json

{
    "cargo": "MEMBRO"
}

### [PERM-02] LIDER altera Maria de MEMBRO para VISUALIZADOR
# Esperado: 200 OK
PATCH {{baseUrl}}/equipes/{{equipeId}}/membros/{{usuarioMariaId}}/cargo
Authorization: Bearer {{loginLider.response.body.$.token}}
Content-Type: application/json

{
    "cargo": "VISUALIZADOR"
}

### [PERM-03] VISUALIZADOR tenta alterar cargo do LIDER
# Esperado: 403 Forbidden
PATCH {{baseUrl}}/equipes/{{equipeId}}/membros/{{liderId}}/cargo
Authorization: Bearer {{loginVisualizador.response.body.$.token}}
Content-Type: application/json

{
    "cargo": "MEMBRO"
}

### [PERM-04] LIDER tenta alterar o próprio cargo
# Esperado: 400 Bad Request
PATCH {{baseUrl}}/equipes/{{equipeId}}/membros/{{liderId}}/cargo
Authorization: Bearer {{loginLider.response.body.$.token}}
Content-Type: application/json

{
    "cargo": "MEMBRO"
}

### [PERM-05] DONO tenta atribuir DONO diretamente
# Esperado: 400 Bad Request
PATCH {{baseUrl}}/equipes/{{equipeId}}/membros/{{liderId}}/cargo
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "cargo": "DONO"
}

# ============================================================
# TRANSFERENCIA DE PROPRIEDADE
# Executar em ordem, sem interromper.
# ============================================================

### [PROP-01] Arthur transfere propriedade para João
# Esperado: 200 OK
PATCH {{baseUrl}}/equipes/{{equipeId}}/propriedade
Authorization: Bearer {{loginDono.response.body.$.token}}
Content-Type: application/json

{
    "novoDonoId": {{liderId}}
}

### [PROP-02] João devolve propriedade para Arthur
# Esperado: 200 OK
PATCH {{baseUrl}}/equipes/{{equipeId}}/propriedade
Authorization: Bearer {{loginLider.response.body.$.token}}
Content-Type: application/json

{
    "novoDonoId": {{donoId}}
}


# ============================================================
# SAIDA E REMOCAO
# Executar esta secao por ultimo.
# ============================================================

### [SAIDA-01] DONO não pode sair da própria equipe
# Esperado: 403 Forbidden
DELETE {{baseUrl}}/equipes/{{equipeId}}/membros/me
Authorization: Bearer {{loginDono.response.body.$.token}}

### [SAIDA-02] Maria sai voluntariamente da equipe
# Esperado: 204 No Content
DELETE {{baseUrl}}/equipes/{{equipeId}}/membros/me
Authorization: Bearer {{loginVisualizador.response.body.$.token}}

### [PERMISSAO-01] LIDER não pode remover o DONO
# Esperado: 403 Forbidden
DELETE {{baseUrl}}/equipes/{{equipeId}}/membros/{{donoId}}
Authorization: Bearer {{loginLider.response.body.$.token}}

### [CONVITE-04] LIDER envia novo convite para Maria
# Esperado: 201 Created
# Execute após SAIDA-02.
# @name novoConviteMaria
POST {{baseUrl}}/convites-equipes
Authorization: Bearer {{loginLider.response.body.$.token}}
Content-Type: application/json

{
    "equipeId": {{equipeId}},
    "convidadoId": {{usuarioMariaId}},
    "cargo": "MEMBRO"
}

### [CONVITE-05] Maria aceita o novo convite
# Esperado: 200 OK
PATCH {{baseUrl}}/convites-equipes/{{novoConviteMaria.response.body.$.id}}/aceitar
Authorization: Bearer {{loginVisualizador.response.body.$.token}}

### [PERMISSAO-03] LIDER remove Maria da equipe
# Esperado: 204 No Content
DELETE {{baseUrl}}/equipes/{{equipeId}}/membros/{{usuarioMariaId}}
Authorization: Bearer {{loginLider.response.body.$.token}}
