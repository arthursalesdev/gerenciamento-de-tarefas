
@baseUrl = http://localhost:3000

### [AUTH-01] Cadastrar usuário de teste
# Esperado: 201 Created
# Execute apenas com um e-mail ainda não cadastrado.
POST {{baseUrl}}/auth/cadastro
Content-Type: application/json

{
    "nome": "Usuário Teste",
    "nomeUsuario": "usuario_teste",
    "email": "usuario.teste@teste.com",
    "senha": "123456"
}

### AUTH-02 — Login por nome de usuário
# @name loginNomeUsuario
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "identificador": "arthur",
    "senha": "123456"
}

### AUTH-03 — Login por e-mail
# @name loginEmail
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "identificador": "arthur@teste.com",
    "senha": "123456"
}

### AUTH-04 — Consultar usuário autenticado
GET http://localhost:3000/auth/me
Authorization: Bearer {{loginNomeUsuario.response.body.$.token}}

### AUTH-05 — Login inválido
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "identificador": "usuario_inexistente",
    "senha": "123456"
}

### [AUTH-06] Login com campos ausentes
# Esperado: 400 Bad Request
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "arthur@teste.com"
}

### [AUTH-07] Consultar usuário sem token
# Esperado: 401 Unauthorized
GET {{baseUrl}}/auth/me

### [AUTH-08] Consultar usuário com token inválido
# Esperado: 401 Unauthorized
GET {{baseUrl}}/auth/me
Authorization: Bearer token-invalido

### [AUTH-09] Cadastrar e-mail duplicado
# Esperado: 409 Conflict
POST {{baseUrl}}/auth/cadastro
Content-Type: application/json

{
    "nome": "Usuário Duplicado",
    "nomeUsuario": "usuario_duplicado",
    "email": "arthur@teste.com",
    "senha": "123456"
}

### [AUTH-10] Cadastrar usuário sem nome
# Esperado: 400 Bad Request
POST {{baseUrl}}/auth/cadastro
Content-Type: application/json

{
    "nomeUsuario": "usuario_sem_nome",
    "email": "sem.nome@teste.com",
    "senha": "123456"
}

### CADASTRO-01 — Novo usuário
POST http://localhost:3000/auth/cadastro
Content-Type: application/json

{
    "nome": "Usuário Integração",
    "nomeUsuario": "usuario_integracao",
    "email": "integracao@teste.com",
    "senha": "Teste123456"
}

### CADASTRO-02 — Nome de usuário já utilizado
POST http://localhost:3000/auth/cadastro
Content-Type: application/json

{
    "nome": "Outro Usuário",
    "nomeUsuario": "arthur",
    "email": "outro.usuario@teste.com",
    "senha": "Teste123456"
}

### CADASTRO-03 — Verificar unicidade sem diferenciar maiúsculas
POST http://localhost:3000/auth/cadastro
Content-Type: application/json

{
    "nome": "Outro Usuário",
    "nomeUsuario": "ARTHUR",
    "email": "outro.usuario2@teste.com",
    "senha": "Teste123456"
}

### CADASTRO-04 — Nome de usuário inválido
POST http://localhost:3000/auth/cadastro
Content-Type: application/json

{
    "nome": "Usuário Inválido",
    "nomeUsuario": "a@",
    "email": "invalido@teste.com",
    "senha": "Teste123456"
}