
@baseUrl = http://localhost:3000

### [AUTH-01] Cadastrar usuário de teste
# Esperado: 201 Created
# Execute apenas com um e-mail ainda não cadastrado.
POST {{baseUrl}}/auth/cadastro
Content-Type: application/json

{
    "nome": "Usuário Teste",
    "email": "usuario.teste@teste.com",
    "senha": "123456"
}

### [AUTH-02] Realizar login
# Esperado: 200 OK
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "arthur@teste.com",
    "senha": "123456"
}

### [AUTH-03] Consultar usuário autenticado
# Esperado: 200 OK
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### [AUTH-04] Login com senha incorreta
# Esperado: 401 Unauthorized
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "arthur@teste.com",
    "senha": "senha-incorreta"
}

### [AUTH-05] Login com campos ausentes
# Esperado: 400 Bad Request
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "arthur@teste.com"
}

### [AUTH-06] Consultar usuário sem token
# Esperado: 401 Unauthorized
GET {{baseUrl}}/auth/me

### [AUTH-07] Consultar usuário com token inválido
# Esperado: 401 Unauthorized
GET {{baseUrl}}/auth/me
Authorization: Bearer token-invalido

### [AUTH-08] Cadastrar e-mail duplicado
# Esperado: 409 Conflict
POST {{baseUrl}}/auth/cadastro
Content-Type: application/json

{
    "nome": "Usuário Duplicado",
    "email": "arthur@teste.com",
    "senha": "123456"
}

### [AUTH-09] Cadastrar usuário sem nome
# Esperado: 400 Bad Request
POST {{baseUrl}}/auth/cadastro
Content-Type: application/json

{
    "email": "sem.nome@teste.com",
    "senha": "123456"
}
